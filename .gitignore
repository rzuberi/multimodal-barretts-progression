# Never commit raw cohort data, derived tables, model outputs, or private metadata.
data/
raw_data/
derived_data/
results/
reports/generated/
analysis/generated/
checkpoints/
models/
embeddings/
features/
figures/generated/

# Common heavy/private formats.
*.csv
*.tsv
*.xlsx
*.xls
*.jsonl
*.sqlite
*.db
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.svs
*.ndpi
*.tif
*.tiff
*.png
*.jpg
*.jpeg
*.pdf

# Allow source-controlled documentation and tiny config/examples if explicitly added.
!docs/**/*.md
!README.md
!PROJECT_STATE.md
!docs/**/*.yaml
!docs/**/*.yml
!docs/**/*.json
!examples/**/*.md

# Local/editor/runtime noise.
.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
